{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "smoke": "vite build --ssr tests/render-smoke.jsx --outDir node_modules/.smoke --logLevel warn && node node_modules/.smoke/render-smoke.js",
    "test": "node --test ../tests/*.test.mjs",
    "preview": "vite preview",
    "pretest:ux": "npm run build",
    "test:ux": "playwright test",
    "preview:pages": "node scripts/serve-pages.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "jszip": "^3.10.2",
    "marked": "^18.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
