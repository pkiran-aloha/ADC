<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Welina.Analytics.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <!-- Shared with the frontend; embed it so published API builds need no data file at runtime. -->
    <EmbeddedResource Include="../../../data/clinicalSeed.json" LogicalName="Welina.Analytics.Api.clinicalSeed.json" />
  </ItemGroup>

</Project>
